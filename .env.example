# Polymarket Monitor Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Polymarket API Credentials
# Get these from your Polymarket builder profile
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here

# Wallet Private Key (for trading - Phase 2)
# WARNING: Keep this extremely secure!
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here

# Database URL
# SQLite (default): sqlite+aiosqlite:///./var/polymarket.db
# PostgreSQL: postgresql+asyncpg://user:pass@localhost/polymarket
DATABASE_URL=sqlite+aiosqlite:///./var/polymarket.db

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Alert Thresholds (defaults)
PRICE_CHANGE_THRESHOLD_PCT=5.0
PRICE_CHANGE_WINDOW_MINUTES=5
VOLUME_SPIKE_THRESHOLD_USD=10000
VOLUME_SPIKE_WINDOW_MINUTES=5
WHALE_TRADE_THRESHOLD_USD=5000

# Logging
LOG_LEVEL=INFO
